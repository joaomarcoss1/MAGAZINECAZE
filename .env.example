# Copie para .env.local e preencha. Sem estas variáveis a loja roda em MODO DEMONSTRAÇÃO.

# URL pública do site (usada em webhooks, retorno do pagamento e SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha no navegador. Usada só no servidor (pedidos, entregas, painel).
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Suas integrações → Credenciais de produção (ou de teste)
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago → Webhooks → Assinatura secreta (obrigatória em produção)
MERCADOPAGO_WEBHOOK_SECRET=
