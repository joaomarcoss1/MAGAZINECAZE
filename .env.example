# Copie para .env.local. Sem credenciais, rode npm run dev para acessar a demonstração.
# A Vercel define VERCEL_ENV. Fora da Vercel, defina APP_ENV=production no build e no start.
APP_ENV=

# Em produção, preencha as variáveis abaixo e use URLs HTTPS.

# URL pública do site (usada em webhooks, retorno do pagamento e SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase local: use as chaves mostradas por supabase status.
# Staging e produção usam projetos e credenciais separados.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha no navegador. Usada só no servidor (pedidos, entregas, painel).
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Suas integrações → Credenciais de produção (ou de teste)
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago → Webhooks → Assinatura secreta (obrigatória em produção)
MERCADOPAGO_WEBHOOK_SECRET=

# Proteções web obrigatórias em staging (APP_ENV=staging) e produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Entrega digital usa a chave service role acima. Habilite confirmação de e-mail no Supabase Auth.
